# settings.local.R  --  machine-specific setting overrides (UNTRACKED)
#
# Copy this file to `settings.local.R` (same folder) and set only the fields you want to change
# on THIS machine. `settings.local.R` is gitignored, so the tracked `settings.R` stays identical
# everywhere and `git pull` never conflicts on it. optimizer_settings() layers these on top of
# its defaults; an unknown key warns (likely a typo). Only top-level settings can be overridden
# (to change a list-valued setting like target_domain, provide the whole list).
#
# NOTE: the local/remote directory split (remote_server) is driven by the ENVIRONMENT, not here
# -- set OPTIMIZER_PATH (or OPTIMIZER_REMOTE) in .Renviron for that. Use this file for the rest.

settings_override <- list(
  # --- typical server tuning ---------------------------------------------
  # simulate            = FALSE,     # run against real T3 data, not the synthetic world
  # max_hours           = 23.5,      # self-stop before a 24 h reservation's walltime
  # run_startup_canary  = FALSE,     # skip the heavy startup canary once validated

  # --- memory ------------------------------------------------------------
  # dosage_budget_bytes caps ONE project's dense dosage matrix at parse time; it sets marker
  # density. dosage_total_budget_bytes caps the SUM over every project covering a trial,
  # which is what actually bounds a worker's peak -- the pipeline holds them all at once.
  # MEASURED (2026-07-29): one worker at dosage_budget_bytes = 16e9, with NO total cap set,
  # held 63 GB RSS on a 128 GB node -- about 2.3 GB of process memory per GB of resident
  # dosage. Uncapped, 16e9 therefore supports exactly ONE worker. WITH the cap it is fine at
  # 8 (see below): the cap, not the per-project budget, is what bounds a worker.
  # This table is for building a FRESH cache:
  #
  #   RAM      workers   dosage_budget_bytes   dosage_total_budget_bytes
  #   256 GB      4              8e9                    19e9
  #   256 GB      8              4e9                     9e9
  #   512 GB      4             16e9                    35e9
  #   512 GB      8              8e9                    18e9
  #
  # With a cache ALREADY on disk, do NOT lower dosage_budget_bytes: get_project_dosage only
  # ever re-parses to make a cache denser, so lowering re-thins nothing and you would pay a
  # full re-download to get WORSE density. Leave it at whatever the cache was built with and
  # let dosage_total_budget_bytes bound memory -- the cap thins at serve time by
  # column-subsetting the cache, which costs nothing. E.g. an existing 16e9 cache on a 512 GB
  # node runs 8 workers at ~24 GB of dosage each (~193 GB total) with the cap at 18e9.
  #
  # Start at half the worker count you want, then scale up after checking: run
  # ./monitor_memory.sh against a live run, then Rscript report_memory.R.
  # CAUTION: changing dosage_budget_bytes changes marker density and therefore scores, and
  # density is not a config parameter -- rows made under different budgets are not comparable
  # (each row records its dosage_budget so the mixing is at least visible).
  # dosage_budget_bytes       = 16e9,    # keep at whatever the CACHE was built with
  # dosage_total_budget_bytes = 18e9,    # 512 GB, 8 workers -- this is what bounds memory

  # --- several workers on one store --------------------------------------
  # Required to run ./run_workers.sh: SQLite's WAL mode cannot work over NFS, so the live
  # store must be on LOCAL disk, with the leader copying it to durable storage.
  #
  # BOTH ARE FILE PATHS, filename included -- not directories. (The convention: *_dir names a
  # directory, *_file and *_path name a file. Note that cache_backup_dir IS a directory while
  # db_backup_path is a file.) Giving a directory is rejected at startup with a message saying
  # what to append.
  # db_path        = "/workdir/<user>/optimizer/evals.sqlite",
  # db_backup_path = "/home/<user>/t3_optimizer/state/evals_backup.sqlite",

  # --- what scheme to optimize -------------------------------------------
  # optimize_scheme     = "CV00"
)
