# T3 / Triticeae Toolbox BrAPI login credentials.
#
# Copy this file to `.Renviron` (same folder) and fill in your real credentials.
# `.Renviron` is gitignored -- never commit it. R reads `.Renviron` once at startup, so
# after editing it you must restart R for the change to take effect.
#
# t3_login() / t3_connect() (R/data_access.R) read these; .brapi_try() re-reads them to
# re-authenticate when the server returns HTTP 401 (e.g. after the token expires).

T3_USERNAME=your_t3_username
T3_PASSWORD=your_t3_password

# Put permanent files (state/, logs/, cache backup) in durable HOME storage rather than the
# working directory when running on a remote server.
# NOTE: SETTING THIS TURNS ON REMOTE MODE AUTOMATICALLY:
# settings.R derives remote_server from it, so you never edit the tracked file
# Leave it unset on a laptop for local mode.
OPTIMIZER_HOME=/home/directory/t3_optimizer

# Optional: force remote mode on/off regardless of OPTIMIZER_HOME (true/false/yes/no/1/0).
# Rarely needed -- the OPTIMIZER_HOME auto-detect above is usually enough.
# OPTIMIZER_REMOTE=true

# Optional: personal R library, for clusters where you install packages yourself rather than
# using a container. R reads exactly ONE .Renviron -- the working directory's if it exists,
# otherwise $HOME's -- and it does not merge them. Since this project always runs from the
# optimizer directory, a ~/.Renviron holding R_LIBS_USER would NEVER BE READ and packages
# would land in the default library (on a cluster, inside a small home quota). So it belongs
# here, next to the credentials. %v expands to the R version.
# Confirm with: Rscript -e '.libPaths()'   -- your path must come first.
# R_LIBS_USER=/project/<account>/R_packages/%v
