#!/bin/bash
# submit.local.sh -- YOUR machine's submission settings. Copy this file once:
#
#   cd <repo>/scripts/Analysis_Claude/optimizer/container
#   cp submit.local.sh.example submit.local.sh
#   chmod +x submit.local.sh
#   # edit the values below, then:
#   ./submit.local.sh
#
# WHY THIS FILE EXISTS. t3opt_ceres.sh is tracked in git, so editing it on the server means a
# conflict on every `git pull`. This file is gitignored, so your account, paths and sizing live
# here and the tracked script is never touched. Same arrangement as settings.R +
# settings.local.R, and .Renviron.example + .Renviron.
#
# The mechanism: sbatch COMMAND-LINE flags override #SBATCH directives inside the script. So
# the directives in t3opt_ceres.sh act as documented defaults, and whatever is set here wins.
#
# ONE RUN AT A TIME. --dependency=singleton (below) tells SLURM not to start this job while an
# earlier job of the same name and user is still going. So to queue a month of work, just
# submit it three times -- they run in sequence, no job ids to capture:
#
#   ./submit.local.sh; ./submit.local.sh; ./submit.local.sh
#
# To deliberately run something alongside -- a debug shakeout, say -- give it a different name,
# which overrides the default:
#
#   ./submit.local.sh --job-name=t3opt-debug --qos=debug --time=00:30:00 --ntasks=4 --mem=200G
#
# Dry run -- prints the allocation it WOULD get, queues nothing:
#
#   ./submit.local.sh --test-only

set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

# ---- who you are ---------------------------------------------------------
# sacctmgr -Pns show user format=account,defaultaccount
ACCOUNT=CHANGEME

# singleton keys on this name. Keep it stable, or the one-run-at-a-time guarantee is lost.
JOB_NAME=t3opt

# ---- where things live: NOT configured here -------------------------------
# REPO is this script's parent, since container/ lives inside the optimizer directory.
export REPO="$(dirname "$HERE")"

# OPTIMIZER_HOME is read from .Renviron and NOT restated, because .Renviron wins regardless:
# R overrides the inherited environment from it at startup (see optimizer_paths.sh). Setting a
# different value here would make the shell bind and restore one directory while R used
# another -- and that failure looks like a permissions problem, not a config mismatch.
_renv="$REPO/.Renviron"
[ -f "$_renv" ] || { echo "no .Renviron at $_renv -- copy .Renviron.example first" >&2; exit 1; }
OPTIMIZER_HOME=$(sed -n 's/^[[:space:]]*OPTIMIZER_HOME[[:space:]]*=[[:space:]]*//p' "$_renv" \
                   | tail -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^["'\'']//' -e 's/["'\'']$//')
# Checked before the absolute-path test, so `${HOME}/...` gets the message that explains it
# rather than the one about leading slashes. R would expand ${HOME} or ~; this shell read does
# not, so the two would disagree -- the very drift this arrangement removes.
case "$OPTIMIZER_HOME" in
  *'$'*|'~'*) echo "OPTIMIZER_HOME in $_renv must be a literal path, not '$OPTIMIZER_HOME'" >&2
              echo "  R expands \${HOME} and ~; this shell read does not, so they would differ." >&2
              exit 1 ;;
esac
case "$OPTIMIZER_HOME" in
  "")   echo "OPTIMIZER_HOME is not set in $_renv" >&2; exit 1 ;;
  /*)   : ;;
  *)    echo "OPTIMIZER_HOME in $_renv must be an absolute path, got '$OPTIMIZER_HOME'" >&2
        exit 1 ;;
esac
export OPTIMIZER_HOME
unset _renv

# The image lives beside the recipe that built it, which is where build.sh writes it and
# run_in_container.sh looks for it. NOT in OPTIMIZER_HOME: that directory is for state you
# cannot regenerate, and a .sif is regenerated by re-running build.sh.
export SIF="${SIF:-$HERE/optimizer.sif}"

# ---- how big -------------------------------------------------------------
# Memory is the binding resource, not cores: measured 19 GB median and 82 GB peak per worker.
# MEM should be at least N_WORKERS x 82 GB. Raise the worker count only after report_memory.R
# shows real headroom -- SLURM kills a job that exceeds its allocation, it does not throttle it.
export N_WORKERS=22
export N_THREADS=1
NTASKS=32
MEM=1800G
TIME=21-00:00:00          # 3 weeks, the ceres maximum

# ---- submit --------------------------------------------------------------
# Logs go to OPTIMIZER_HOME, on durable storage, so they outlive the node -- matching where
# run_workers.sh puts the per-worker logs (settings$log_dir). The #SBATCH directives in
# t3opt_ceres.sh use RELATIVE paths, which SLURM resolves against whatever directory you
# happened to submit from; passing an absolute path here removes that dependence.
#
# The mkdir is not optional: SLURM does not create the directory, and a job whose output file
# cannot be opened dies at launch with the error going nowhere -- because the output file is
# where it would have gone. That failure looks exactly like "nothing happened".
mkdir -p "$OPTIMIZER_HOME/logs"

# "$@" comes before the script path so extra arguments reach sbatch, not the job.
exec sbatch \
  --account="$ACCOUNT" \
  --job-name="$JOB_NAME" \
  --dependency=singleton \
  --chdir="$REPO" \
  --output="$OPTIMIZER_HOME/logs/slurm-%j.out" \
  --error="$OPTIMIZER_HOME/logs/slurm-%j.err" \
  --ntasks="$NTASKS" \
  --mem="$MEM" \
  --time="$TIME" \
  --export=ALL \
  "$@" \
  "$HERE/t3opt_ceres.sh"
