#!/bin/bash
# submit.local.sh -- YOUR account and node sizing. Copy this file once:
#
#   cd <repo>/scripts/Analysis_Claude/optimizer/container
#   cp submit.local.sh.example submit.local.sh
#   chmod +x submit.local.sh
#   # edit the values below, then:
#   ./submit.local.sh
#
# VALUES ONLY. Everything mechanical -- paths, validation, the sbatch flags -- lives in the
# TRACKED container/lib_submit.sh, sourced at the bottom. That split matters: this file is
# gitignored, so `git pull` never updates it, and a copy made months ago would keep submitting
# the way it did then. Keeping logic out of here means fixes reach you without a re-copy.
#
# If you ever want to change HOW submission works, edit lib_submit.sh, not this file.
#
# ONE RUN AT A TIME. lib_submit.sh passes --dependency=singleton, so SLURM will not start this
# job while an earlier one of the same name and user is going. To queue a month of work, just
# submit repeatedly -- they run in sequence, no job ids to capture:
#
#   ./submit.local.sh; ./submit.local.sh; ./submit.local.sh
#
# Extra arguments pass straight through to sbatch. To run something ALONGSIDE the main job --
# a debug shakeout, say -- give it a different name, which overrides JOB_NAME:
#
#   ./submit.local.sh --job-name=t3opt-debug --qos=debug --time=00:30:00 --ntasks=4 --mem=200G
#
# Dry run -- prints the allocation it WOULD get, queues nothing:
#
#   ./submit.local.sh --test-only

set -euo pipefail

# ---- who you are ---------------------------------------------------------
# sacctmgr -Pns show user format=account,defaultaccount
ACCOUNT=CHANGEME

# singleton keys on this name. Keep it stable, or the one-run-at-a-time guarantee is lost.
JOB_NAME=t3opt

# ---- how big -------------------------------------------------------------
# Memory is the binding resource, not cores: measured 19 GB median and 82 GB peak per worker.
# MEM should be at least N_WORKERS x 82 GB. Raise the worker count only after tools/report_memory.R
# shows real headroom -- SLURM kills a job that exceeds its allocation, it does not throttle it.
#
# N_WORKERS and N_THREADS are exported because they must reach the JOB, through --export=ALL.
# The others are read by submit_optimizer in this same shell, so they need no export.
export N_WORKERS=22
export N_THREADS=1
NTASKS=32
MEM=1800G

# The ONLY wall-clock declaration. The job is meant to run until SLURM kills it here -- see the
# note at the end of settings.local.R.scinet.
TIME=21-00:00:00          # 3 weeks, the ceres maximum

# ---- submit --------------------------------------------------------------
# OPTIMIZER_HOME comes from .Renviron and REPO from this file's location; neither is set here,
# so neither can drift out of step. See lib_submit.sh.
. "$(cd "$(dirname "$0")" && pwd)/lib_submit.sh"
submit_optimizer "$@"
