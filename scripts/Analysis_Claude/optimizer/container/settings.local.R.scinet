# settings.local.R for SciNet Ceres.
#
#   cp container/settings.local.R.scinet settings.local.R
#
# Ceres compute nodes each have 1.5 TB of local SSD scratch, reached through $TMPDIR, which
# SLURM sets per job to /local/bgfs/<jobid>. That is genuinely node-local disk, which is what
# SQLite's WAL requires -- /project and /home are network filesystems and WAL cannot work on
# them (open_store() warns, and the consequence of ignoring it is a corrupted store).
#
# $TMPDIR IS ERASED WHEN THE JOB EXITS. Nothing here survives on its own; the durable copies
# under OPTIMIZER_HOME are what persist, and t3opt_ceres.sh restores from them at job start.

# Paths are computed at RUNTIME from the environment, never hardcoded: $TMPDIR contains the
# job id, so it is different for every job.
.tmp  <- Sys.getenv("TMPDIR")
.home <- Sys.getenv("OPTIMIZER_HOME")

# Refuse to run rather than silently fall back. Without $TMPDIR the store would land on a
# network filesystem shared by every worker, which is the one configuration that corrupts it.
if (!nzchar(.tmp))
  stop("TMPDIR is unset. On Ceres it is set inside a SLURM job (/local/bgfs/<jobid>).\n",
       "  Running on a login node? Get an allocation first: salloc -N1 -n4 -t 1:00:00 -A <account>")
if (!nzchar(.home))
  stop("OPTIMIZER_HOME is unset -- set it in .Renviron to your /project path.")

settings_override <- list(

  # ---- the live store: node-local SSD ------------------------------------
  # Backed up to OPTIMIZER_HOME every db_backup_minutes by whichever worker gets there first
  # (not just the leader -- see LESSONS #25), and once more when the job ends.
  db_path = file.path(.tmp, "evals.sqlite"),

  # ---- the cache: also node-local, because it fits -------------------------
  # 1.5 TB of local SSD is far more than the cache needs, and it is much faster than /project
  # for the dosage matrices, which dominate evaluation time. restore_cache_from_backup()
  # repopulates this from cache_backup_dir at startup, so a fresh node warms itself.
  # Drop this line to keep the cache on /project instead -- slower, but it survives the job.
  cache_dir = file.path(.tmp, "cache"),

  # ---- sizing ------------------------------------------------------------
  # Memory is the binding resource: measured 19 GB median, 82 GB peak per worker. Raise only
  # after report_memory.R shows headroom on a real Ceres run.
  dosage_budget_bytes = 16e9,

  # Stop cleanly before SLURM kills the job, so the final backup actually happens. Set this
  # BELOW the #SBATCH --time value; the difference is the margin for one in-flight evaluation
  # to finish (median 29 min, so an hour of margin is not excessive).
  max_hours = 20 * 24
)
